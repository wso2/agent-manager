# pnpm-lock.yaml is generated, and a line-wise merge of it may be silently invalid.
# merge=binary makes git refuse to merge it; regenerate with "pnpm install" instead.
pnpm-lock.yaml               merge=binary

# TypeScript's tsconfig files use JavaScript-style code comments. The rule below prevents
# pedantic syntax highlighters such as GitHub's from highlighting these comments as errors.
# Your text editor may also require a special configuration to allow comments in JSON.
tsconfig*.json               linguist-language=JSON-with-Comments
