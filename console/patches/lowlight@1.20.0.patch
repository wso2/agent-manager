@@ -196,6 +200,30 @@ function open(name) {
   stack.push(child)
 }
 
+// Map a highlight.js 11 scope such as `title.function` to the class names
+// highlight.js itself renders (`hljs-title function_`).
+function startScope(scope) {
+  var parts = scope.split('.')
+  var className = [this.options.classPrefix + parts[0]]
+  var index = 0
+  var stack = this.stack
+  var child
+
+  while (++index < parts.length) {
+    className.push(parts[index] + '_'.repeat(index))
+  }
+
+  child = {
+    type: 'element',
+    tagName: 'span',
+    properties: {className: className},
+    children: []
+  }
+
+  stack[stack.length - 1].children.push(child)
+  stack.push(child)
+}
+
 function close() {
   this.stack.pop()
 }
