{
  "name": "@agent-management-platform/monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:core-ui": "pnpm --filter @agent-management-platform/am-core-ui... run build",
    "dev": "pnpm --filter web-ui run dev",
    "lint": "pnpm -r --no-sort run lint",
    "lint:fix": "pnpm -r --no-sort run lint:fix"
  },
  "pnpm": {
    "overrides": {
      "ws": "^8.21.1",
      "axios": "^1.20.0",
      "dompurify": "^3.4.17",
      "prismjs": "^1.30.0",
      "js-yaml@<4.3.2": "^4.3.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12"
    }
  }
}
