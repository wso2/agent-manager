FROM public.ecr.aws/docker/library/node:20.19-alpine

# Install Git and gettext (for envsubst)
RUN apk add --no-cache git gettext

# corepack activates the pnpm version pinned in package.json's packageManager field
RUN corepack enable

# WORKDIR_PATH must match the host's absolute path to the console directory
# so that pnpm symlinks in the virtual store resolve correctly on both
# the host and inside the container.
ARG WORKDIR_PATH=/app
WORKDIR ${WORKDIR_PATH}

# Copy workspace configuration and entire monorepo structure
# This is needed for proper dependency resolution
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/ apps/
COPY workspaces/ workspaces/
COPY dev-start.sh ./dev-start.sh
RUN chmod +x ./dev-start.sh

# Install all dependencies during image build, not at runtime
RUN pnpm install --frozen-lockfile

# Note: Source code will be mounted as volumes that override these files.
# pnpm install runs again at container startup (dev-start.sh) to re-link
# binaries for the container's runtime paths.

# Expose Vite dev server port
EXPOSE 3000

# Use polling for file watching to avoid EMFILE errors with native watchers
ENV CHOKIDAR_USEPOLLING=true

CMD ["sh", "dev-start.sh"]
