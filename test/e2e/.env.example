# Copy to .env and fill in. The Makefile sources test/e2e/.env automatically.
# Every value below has a default (shown) that matches the quick-start install,


# --- Endpoints ---
AMP_API_BASE_URL=http://api.amp.localhost:8080
AM_OBSERVER_BASE_URL=http://traces.amp.localhost:11080

# --- Auth (OAuth2 client credentials) ---
IDP_TOKEN_URL=http://thunder.amp.localhost:8080/oauth2/token
IDP_CLIENT_ID=amp-api-client
IDP_CLIENT_SECRET=amp-api-client-secret

# Required by security/roles to create and remove disposable role personas.
# Override all three with secret-backed values outside local quick-start.
THUNDER_ADMIN_URL=http://thunder.amp.localhost:8080
# Optional when Thunder's System resource identifier is not <admin-url>/mcp.
# THUNDER_SYSTEM_RESOURCE=https://thunder.example.com/mcp
THUNDER_SYSTEM_CLIENT_ID=amp-system-client
THUNDER_SYSTEM_CLIENT_SECRET=amp-system-client-secret

# Environment-specific Thunder token endpoint used by security/agentid.
# Leave empty to discover the registered opaque-handle URL through Agent Manager.
# Shared/cloud deployments may override discovery with an explicitly routed URL.
AGENT_IDP_TOKEN_URL=

# Source used to build the deployed security/runtime probe. Before this fixture
# reaches main, point these at a pushed branch containing the fixture path.
SECURITY_PROBE_REPOSITORY_URL=https://github.com/wso2/agent-manager
SECURITY_PROBE_REPOSITORY_BRANCH=main
SECURITY_PROBE_APP_PATH=/test/e2e/fixtures/security-probe-agent

# --- Target org/project/environment ---
DEFAULT_ORG=default
DEFAULT_PROJECT=default
DEFAULT_ENV=default

# --- Timeouts ---
READINESS_TIMEOUT=5m

# --- LLM keys ---
OPENAI_API_KEY=        # REQUIRED: builds/invokes the IT helpdesk agents
TAVILY_API_KEY=        # optional: only for agents that use Tavily
