# Cluster CLI versions used by CI (.github/actions/setup-cluster-clis) and
# recommended for local setup. Plain KEY=VALUE so shells and workflows can both read it.
#
# kubectl tracks the k3s image in deployments/k3d-local-config.yaml (+/-1 minor skew).
KUBECTL_VERSION=v1.32.9
K3D_VERSION=v5.8.3
K3D_SHA256_LINUX_AMD64=dbaa79a76ace7f4ca230a1ff41dc7d8a5036a8ad0309e9c54f9bf3836dbe853e
HELM_VERSION=v3.19.4
