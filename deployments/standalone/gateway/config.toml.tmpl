# AI Gateway configuration for the standalone install, shared by
# gateway-controller and gateway-runtime. gateway-init.sh fills the @@NAME@@
# placeholders and writes the result to the gateway volume.
[controller.server]
api_port = 9090
xds_port = 18000
shutdown_timeout = "15s"
gateway_id = "platform-gateway-id"
skip_invalid_deployments_on_startup = false
[controller.admin_server]
enabled = true
port = 9092
allowed_ips = ["*"]
[controller.admin_server.config_dump]
enabled = false
[controller.admin_server.pprof]
enabled = false
block_profile_rate = 0
mutex_profile_fraction = 0
[controller.policy_server]
port = 18001
[controller.policy_server.tls]
enabled = false
cert_file = "./certs/server.crt"
key_file = "./certs/server.key"
[controller.storage]
type = "sqlite"
[controller.storage.sqlite]
path = "./data/gateway.db"
[controller.policies]
definitions_path = "./default-policies"
build_manifest_path = "./build-manifest.yaml"
[controller.llm]
template_definitions_path = "./default-llm-provider-templates"
[controller.controlplane]
host = "@@CONTROLPLANE_HOST@@"
token = "@@CONTROLPLANE_TOKEN@@"
insecure_skip_verify = true
reconnect_initial = "1s"
reconnect_max = "5m"
polling_interval = "15m"
deployment_sync_enabled = true
sync_batch_size = 50
gateway_name = ""
apim_oauth2_client_id = ""
apim_oauth2_client_secret = ""
apim_oauth2_username = ""
apim_oauth2_password = ""
[controller.event_hub]
poll_interval = "3s"
cleanup_interval = "10m"
retention_period = "1h"
[controller.event_hub.database]
max_open_conns = 5
max_idle_conns = 2
conn_max_lifetime = "30m"
conn_max_idle_time = "5m"
[[controller.encryption.providers]]
type = "aesgcm"
[[controller.encryption.providers.keys]]
version = "aesgcm256-v1"
file = "/amp/gw/aesgcm-keys/default-aesgcm256-v1.bin"
[router]
gateway_host = "*"
listener_port = 19080
https_enabled = true
https_port = 22894
tracing_service_name = "router"
[router.vhosts.main]
default = "*"
[router.vhosts.sandbox]
default = "sandbox-*"
[router.access_logs]
enabled = true
format = "json"
json_fields = {bytesRx = "%BYTES_RECEIVED%", bytesTx = "%BYTES_SENT%", connTrmDtl = "%CONNECTION_TERMINATION_DETAILS%", dur = "%DURATION%", host = "%REQ(:AUTHORITY)%", meth = "%REQ(:METHOD)%", path = "%REQ(X-ENVOY-ORIGINAL-PATH?:PATH)%", proto = "%PROTOCOL%", reqDur = "%REQUEST_DURATION%", reqId = "%REQ(X-REQUEST-ID)%", reqTxDur = "%REQUEST_TX_DURATION%", respCd = "%RESPONSE_CODE%", respCdDtl = "%RESPONSE_CODE_DETAILS%", respDur = "%RESPONSE_DURATION%", respFlg = "%RESPONSE_FLAGS%", respTxDur = "%RESPONSE_TX_DURATION%", t = "%START_TIME%", ua = "%REQ(USER-AGENT)%", upHost = "%UPSTREAM_HOST%", upPath = "%REQ(:PATH)%", upProto = "%UPSTREAM_PROTOCOL%", upSvcT = "%RESP(X-ENVOY-UPSTREAM-SERVICE-TIME)%", xff = "%REQ(X-FORWARDED-FOR)%" }
[router.downstream_tls]
cert_path = "/amp/gw/listener-certs/default-listener.crt"
key_path = "/amp/gw/listener-certs/default-listener.key"
minimum_protocol_version = "TLS1_2"
maximum_protocol_version = "TLS1_3"
ciphers = "ECDHE-ECDSA-AES128-GCM-SHA256,ECDHE-RSA-AES128-GCM-SHA256,ECDHE-ECDSA-AES128-SHA,ECDHE-RSA-AES128-SHA,AES128-GCM-SHA256,AES128-SHA,ECDHE-ECDSA-AES256-GCM-SHA384,ECDHE-RSA-AES256-GCM-SHA384,ECDHE-ECDSA-AES256-SHA,ECDHE-RSA-AES256-SHA,AES256-GCM-SHA384,AES256-SHA"
[router.upstream.tls]
minimum_protocol_version = "TLS1_2"
maximum_protocol_version = "TLS1_3"
ciphers = "ECDHE-ECDSA-AES128-GCM-SHA256,ECDHE-RSA-AES128-GCM-SHA256,ECDHE-ECDSA-AES128-SHA,ECDHE-RSA-AES128-SHA,AES128-GCM-SHA256,AES128-SHA,ECDHE-ECDSA-AES256-GCM-SHA384,ECDHE-RSA-AES256-GCM-SHA384,ECDHE-ECDSA-AES256-SHA,ECDHE-RSA-AES256-SHA,AES256-GCM-SHA384,AES256-SHA"
trusted_cert_path = "/etc/ssl/certs/ca-certificates.crt"
custom_certs_path = "./certificates"
verify_host_name = true
disable_ssl_verification = false
[router.upstream.timeouts]
route_timeout_ms = 60000
route_idle_timeout_ms = 300000
connect_timeout_ms = 5000
[router.lua.request_transformation]
script_path = "./lua/request_transformation.lua"
[router.http_listener]
server_header_transformation = "OVERWRITE"
server_header_value = "WSO2 API Platform"
per_connection_buffer_limit_bytes = 1048576
disable_path_normalization = false
path_with_escaped_slashes_action = "KEEP_UNCHANGED"
[router.http_listener.timeouts]
request_timeout = "0s"
request_headers_timeout = "0s"
stream_idle_timeout = "5m"
idle_timeout = "1h"
[router.policy_engine]
mode = "uds"
host = ""
port = 9001
timeout_ms = 60000
route_cache_action = "RETAIN"
message_timeout_ms = 60000
[router.policy_engine.tls]
enabled = false
[controller.auth.basic]
enabled = true
[[controller.auth.basic.users]]
username = "admin"
password = "@@GATEWAY_ADMIN_PASSWORD@@"
password_hashed = false
roles = ["admin"]
[controller.auth.idp]
enabled = false
jwks_url = ""
issuer = ""
roles_claim = "scope"
[controller.logging]
level = "info"
format = "json"
[controller.metrics]
enabled = false
port = 9091
[policy_engine]
tracing_service_name = "policy-engine"
[policy_engine.request_body]
max_decompressed_bytes = 10485760
[policy_engine.response_body]
max_decompressed_bytes = 10485760
[policy_engine.server]
extproc_port = 9001
[policy_engine.admin]
enabled = true
port = 9002
allowed_ips = ["*", "127.0.0.1"]
[policy_engine.admin.config_dump]
enabled = false
[policy_engine.admin.pprof]
enabled = false
block_profile_rate = 0
mutex_profile_fraction = 0
[policy_engine.config_mode]
mode = "xds"
[policy_engine.xds]
connect_timeout = "10s"
request_timeout = "5s"
initial_reconnect_delay = "1s"
max_reconnect_delay = "60s"
[policy_engine.xds.tls]
enabled = false
[policy_engine.file_config]
path = ""
[policy_engine.logging]
level = "info"
format = "json"
[policy_engine.metrics]
enabled = false
port = 9003
[policy_engine.python_executor]
timeout = "30s"
[policy_engine.python_executor.server]
mode = "uds"
port = 9010
host = "localhost"
[policy_configurations.llm_cost_v1]
pricing_file = "/etc/policy-engine/llm-pricing/model_prices.json"
[policy_configurations.jwtauth_v1]
allowedalgorithms = ["RS256", "ES256"]
authheaderscheme = ""
errormessage = "Authentication failed"
errormessageformat = "json"
jwkscachettl = "5m"
jwksfetchretrycount = 3
jwksfetchretryinterval = "2s"
jwksfetchtimeout = "5s"
leeway = "30s"
onfailurestatuscode = 401
validateissuer = true
[[policy_configurations.jwtauth_v1.keymanagers]]
issuer = "agent-manager-service"
name = "agent-manager-service"
[policy_configurations.jwtauth_v1.keymanagers.jwks.remote]
skipTlsVerify = true
uri = "@@AMP_JWKS_URL@@"
[[policy_configurations.jwtauth_v1.keymanagers]]
issuer = "@@THUNDER_ISSUER@@"
name = "ThunderKeyManager"
[policy_configurations.jwtauth_v1.keymanagers.jwks.remote]
skipTlsVerify = true
uri = "@@THUNDER_JWKS_URL@@"
[policy_configurations.llm_cost_ratelimit_v1]
cost_scale_factor = 1000000000
[policy_configurations.mcpauth_v1]
gatewayhost = "@@GATEWAY_HOST@@"
[policy_configurations.ratelimit_v1]
algorithm = "fixed-window"
backend = "memory"
[policy_configurations.ratelimit_v1.memory]
cleanup_interval = "5m"
max_entries = 10000
[api_key]
api_keys_per_user_per_api = 10
algorithm = "sha256"
min_key_length = 36
max_key_length = 128
issuer = ""
[immutable_gateway]
enabled = false
artifacts_dir = "/etc/api-platform-gateway/immutable_gateway/artifacts"
[mcp]
append_resource_path_to_backend = false
