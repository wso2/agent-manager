# Copy to .env and adjust. docker compose reads .env from this directory.

COMPOSE_PROJECT_NAME=amp-lite

# Images. `make up` builds the AMP ones from this checkout; or point at a release.
AMP_API_IMAGE=amp-api:lite
AMP_OBSERVER_IMAGE=amp-observer:lite
AMP_CONSOLE_IMAGE=amp-console:lite
THUNDER_IMAGE=ghcr.io/thunder-id/thunderid:1.0.2
GATEWAY_CONTROLLER_IMAGE=ghcr.io/wso2/api-platform/gateway-controller:2026.09.24
GATEWAY_RUNTIME_IMAGE=ghcr.io/wso2/api-platform/gateway-runtime:2026.09.24
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.6.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.163.2

# Ports published on the host.
AMP_API_PORT=9000
AMP_INTERNAL_PORT=9243
OBSERVER_PORT=9098
CONSOLE_PORT=3000
GATEWAY_PORT=19080

# ThunderID listens on THUNDER_PORT inside and outside Docker. Browsers reach
# it as THUNDER_HOST (*.localhost resolves to 127.0.0.1); tokens carry
# http://THUNDER_HOST:THUNDER_PORT as their issuer.
THUNDER_HOST=thunder.amp.localhost
THUNDER_PORT=8080

# Agent traffic and OTLP ingest go to this gateway host.
GATEWAY_HOST=default-default.gateway.localhost

# Documentation the console links to (wso2.com/agent-platform/docs/<version>).
DOCS_VERSION=next

# Secrets. Local-development values; change all of them for anything shared.
THUNDER_ADMIN_PASSWORD=admin
AMP_API_CLIENT_SECRET=amp-api-client-secret
AMP_CONSOLE_CLIENT_SECRET=amp-console-client-secret
AMP_PUBLISHER_CLIENT_SECRET=amp-publisher-client-secret
AMP_SYSTEM_CLIENT_SECRET=amp-system-client-secret
# AES-256-GCM key, 64 hex characters (openssl rand -hex 32).
AMP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GATEWAY_ADMIN_PASSWORD=admin
# OpenSearch requires a strong admin password (upper, lower, digit, symbol).
OPENSEARCH_PASSWORD=ThisIsTheOpenSearchPassword1!
