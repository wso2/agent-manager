# Copy to .env and adjust. docker compose reads .env from this directory.

COMPOSE_PROJECT_NAME=amp-lite

# Images. `make up` builds the AMP ones from this checkout; or point at a release.
AMP_API_IMAGE=amp-api:lite
THUNDER_IMAGE=ghcr.io/thunder-id/thunderid:1.0.2
GATEWAY_CONTROLLER_IMAGE=ghcr.io/wso2/api-platform/gateway-controller:2026.09.24
GATEWAY_RUNTIME_IMAGE=ghcr.io/wso2/api-platform/gateway-runtime:2026.09.24

# Ports published on the host.
AMP_API_PORT=9000
AMP_INTERNAL_PORT=9243
# The console is served on AMP_API_PORT. CONSOLE_PORT is only the dev console
# (`make console`, Vite), which must stay on 3000.
CONSOLE_PORT=3000
GATEWAY_PORT=19080

# ThunderID listens on THUNDER_PORT inside and outside Docker. Browsers reach
# it as THUNDER_HOST (*.localhost resolves to 127.0.0.1); tokens carry
# http://THUNDER_HOST:THUNDER_PORT as their issuer.
THUNDER_HOST=thunder.amp.localhost
THUNDER_PORT=8080

# Agent traffic goes to this gateway host.
GATEWAY_HOST=default-default.gateway.localhost

# Database. SQLite (in the amp-data volume) is the default. For PostgreSQL,
# set both lines below; the postgres profile starts a PostgreSQL container.
#COMPOSE_PROFILES=postgres
#AMP_DB_DRIVER=postgres
POSTGRES_IMAGE=postgres:18-alpine

# How operators sign in to the console.
#   file  - against the user file amp-init generates from the accounts below,
#           with the API issuing its own tokens. No identity provider needed.
#   idp   - hand sign-in to ThunderID.
# ThunderID runs either way: agent identity still uses it.
#
# Switching to idp takes both of these, not just the first. The JWKS URL
# defaults to the API's own key set, and that default does not follow
# AUTH_MODE — set AUTH_MODE alone and amp-api keeps validating against its
# own keys, so every ThunderID token is refused with a bare 401.
#
#   AUTH_MODE=idp
#   KEY_MANAGER_JWKS_URL=http://thunder:${THUNDER_PORT}/oauth2/jwks
#
# The console reads AUTH_MODE too and must match: "idp" here selects ThunderID
# there. In file mode amctl and the MCP endpoints still sign in through
# ThunderID, so they need idp.
AUTH_MODE=file

# Extra console users bootstrapped into ThunderID besides admin, as
# comma-separated username:password[:admin] entries (no ',' or ':' inside).
# ":admin" adds the user to the Agent Manager admins group. In file mode these
# are the sign-in accounts too, alongside admin.
AMP_DEFAULT_USERS=

# Console UI modules to turn on besides those the API's modules offer
# (module ids or <module>/<page>, e.g. "agent-runtime agent-portal").
CONSOLE_UI_MODULES_ENABLE=

# Documentation the console links to (wso2.com/agent-platform/docs/<version>).
DOCS_VERSION=next

# Secrets. Local-development values; change all of them for anything shared.

# The console admin password, for the `admin` account. Agent Manager owns it
# and hands the same value to ThunderID's setup, so it is the password in both
# sign-in modes and survives ThunderID leaving the stack.
AMP_ADMIN_PASSWORD=admin
AMP_API_CLIENT_SECRET=amp-api-client-secret
AMP_CONSOLE_CLIENT_SECRET=amp-console-client-secret
AMP_SYSTEM_CLIENT_SECRET=amp-system-client-secret
# AES-256-GCM key, 64 hex characters (openssl rand -hex 32).
AMP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Comma-separated earlier AMP_ENCRYPTION_KEY values, kept after a rotation so
# secrets sealed with them stay readable. See "Rotate the encryption key" in
# docs/user-guide.md.
AMP_ENCRYPTION_KEY_PREVIOUS=
GATEWAY_ADMIN_PASSWORD=admin
# The bundled gateway's control-plane registration token. Empty: amp-init
# generates one on first run and keeps it. To set one, use the format
# <uuid>-<43 base64url characters>.
DEFAULT_GATEWAY_TOKEN=
POSTGRES_USER=amp
POSTGRES_PASSWORD=amp
POSTGRES_DB=agent_manager

# The organization's analytics dashboard (Moesif or any other tool), opened by
# "Advanced analytics" on the Cost Management dashboard. Empty: no analytics link.
ANALYTICS_DASHBOARD_URL=
