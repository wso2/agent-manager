# Optional. Copy to .env to change what Compose itself needs: images, host
# ports and ThunderID's network name. Every value below is also the default
# in docker-compose.yml. Agent Manager's own settings are in amp.yaml, and its
# secrets are generated on first start (docker compose exec amp-api amp secret
# show admin-password).

# Images. `make up` builds the AMP one from this checkout; or point at a release.
AMP_API_IMAGE=amp-api:lite
#THUNDER_IMAGE=ghcr.io/thunder-id/thunderid:1.0.2
#GATEWAY_CONTROLLER_IMAGE=ghcr.io/wso2/api-platform/gateway-controller:2026.09.24
#GATEWAY_RUNTIME_IMAGE=ghcr.io/wso2/api-platform/gateway-runtime:2026.09.24
#POSTGRES_IMAGE=postgres:18-alpine
# The observability profile's images.
#CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8.33.6
#OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.163.2

# Host ports. Change server.public_url in amp.yaml to match AMP_API_PORT.
#AMP_API_PORT=9000
#AMP_INTERNAL_PORT=9243
#GATEWAY_PORT=19080
# The dev console (`make console`, Vite), which must stay on 3000.
#CONSOLE_PORT=3000

# ThunderID listens on THUNDER_PORT inside and outside Docker, and browsers
# reach it as THUNDER_HOST (*.localhost resolves to 127.0.0.1). Change
# thunder.base_url in amp.yaml to match.
#THUNDER_HOST=thunder.amp.localhost
#THUNDER_PORT=8080

# Agent traffic goes to this gateway host.
#GATEWAY_HOST=default-default.gateway.localhost

# Start the bundled PostgreSQL too; then set the db: block in amp.yaml as its
# comment says, or add docker-compose.postgres.yml to COMPOSE_FILE.
#COMPOSE_PROFILES=postgres

# Observability (traces). The observability profile runs ClickHouse and the
# OpenTelemetry collector on an internal network with no published ports, and
# applies the trace schema with `amp migrate` before amp-api starts. Set the
# profile and both URLs (`make up-observability` does it for one run); with
# postgres too, COMPOSE_PROFILES=postgres,observability. Then install the
# module: docker compose exec amp-api amp module install observability.
# For your own ClickHouse, see docs/amp-lite/observability.md.
#COMPOSE_PROFILES=observability
#AMP_OBSERVABILITY_CLICKHOUSE_URL=http://clickhouse:8123
#AMP_OBSERVABILITY_COLLECTOR_URL=http://otel-collector:4318
# Days ClickHouse keeps spans (30 when empty); amp migrate applies it.
#AMP_OBSERVABILITY_TTL_DAYS=30
# ClickHouse's logins (users.xml): amp_migrator for amp migrate, amp_ingest
# for the collector, amp_reader and amp_cleaner for the module. These have no
# default: ClickHouse refuses to start while any is empty.
AMP_CLICKHOUSE_MIGRATOR_PASSWORD=change-me-migrator
AMP_CLICKHOUSE_INGEST_PASSWORD=change-me-ingest
AMP_CLICKHOUSE_READER_PASSWORD=change-me-reader
AMP_CLICKHOUSE_CLEANER_PASSWORD=change-me-cleaner
