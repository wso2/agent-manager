{
  "index_patterns": ["otel-traces-*"],
  "priority": 100,
  "template": {
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 8191 }
          }
        }
      ],
      "properties": {
        "traceId": { "type": "keyword" },
        "spanId": { "type": "keyword" },
        "parentSpanId": { "type": "keyword" },
        "name": { "type": "keyword" },
        "startTime": { "type": "date_nanos" },
        "endTime": { "type": "date_nanos" }
      }
    }
  }
}
