# Server Configuration
AM_OBSERVER_PORT=9098

LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Observer Service Configuration
# -----------------------------------------------------------------------------
OPENCHOREO_OBSERVER_URL=http://localhost:8085
IDP_TOKEN_URL=http://localhost:8090/oauth2/token
IDP_CLIENT_ID=am-observer-client
IDP_CLIENT_SECRET=am-observer-client-secret

# Namespace all trace queries are scoped to (single-namespace deployment).
OBSERVER_DEFAULT_NAMESPACE=default

# -----------------------------------------------------------------------------
# Development Environment
# Set IS_LOCAL_DEV_ENV=true to skip JWT validation (local dev only).
# In production, set IS_LOCAL_DEV_ENV=false and configure the Key Manager below.
# -----------------------------------------------------------------------------
IS_LOCAL_DEV_ENV=true

# -----------------------------------------------------------------------------
# Key Manager Configuration (must match agent-manager-service values)
# The UI sends the same JWT to both services, so validation config must be identical.
# Required when IS_LOCAL_DEV_ENV=false.
# -----------------------------------------------------------------------------
# KEY_MANAGER_JWKS_URL=
# KEY_MANAGER_ISSUER=Agent Management Platform Local
# Must include the MCP resource identifier (SERVER_PUBLIC_URL with a trailing
# slash) — Thunder stamps the RFC 8707 resource parameter as the token
# audience for MCP logins — plus the inbound service audiences.
# KEY_MANAGER_AUDIENCE=urn:wso2:amp,amp-api-client,am-obs-mcp,http://traces.amp.localhost:11080/
# When running the binary directly (SERVER_PUBLIC_URL=http://localhost:9098),
# use http://localhost:9098/ as the audience entry instead, and register that
# identifier via OBSERVER_MCP_RESOURCE in deployments/setup/register-amp-resources.sh:
# KEY_MANAGER_AUDIENCE=urn:wso2:amp,amp-api-client,am-obs-mcp,http://localhost:9098/

# -----------------------------------------------------------------------------
# OAuth 2.0 Protected Resource Metadata (RFC 9728), consumed by MCP clients to
# discover the authorization server for the /mcp route. Optional: when unset,
# GET /.well-known/oauth-protected-resource returns 503 and 401 responses omit
# the resource_metadata parameter, but WWW-Authenticate is always sent.
# -----------------------------------------------------------------------------
# Externally reachable base URL of this service. Must be the exact URL MCP
# clients connect with: the ingress URL when running in the local kind
# cluster, or http://localhost:9098 when running the binary directly.
# SERVER_PUBLIC_URL=http://traces.amp.localhost:11080

# Comma-separated list of OAuth 2.0 authorization server URLs.
# OAUTH_AUTHORIZATION_SERVERS=http://thunder.amp.localhost:8080

# Comma-separated list of OAuth 2.0 scopes supported by this resource.
# OAUTH_SCOPES_SUPPORTED=amp:observability:trace-read,amp:observability:log-read,amp:observability:build-log-read,amp:observability:metric-read

# Enables scope-based authorization on the REST data routes (default false).
# RBAC_ENABLED=true
