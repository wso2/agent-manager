FROM public.ecr.aws/docker/library/golang:1.26.10-alpine

# Install Air for hot-reloading and bash/openssl for key generation.
# Air is pinned: the image ships GOTOOLCHAIN=local, so any Air release that
# needs a newer Go than the base image above fails the build. Bump this pin
# and the base image together.
RUN apk add --no-cache 'ca-certificates>=20261020' 'ca-certificates-bundle>=20261020' bash openssl && \
    go install github.com/air-verse/air@v1.67.1

WORKDIR /app

# Seed ownership for the keys volume outside the read-only source mount.
RUN addgroup -g 1000 app && adduser -D -u 1000 -G app app && \
    mkdir -p /var/lib/agent-manager/keys && chown 1000:1000 /var/lib/agent-manager/keys
ENV GOCACHE=/home/app/.cache/go-build \
    GOMODCACHE=/home/app/.cache/go-mod
USER 1000:1000

# Prime the runtime user's module cache before mounting source for hot reload.
COPY go.mod go.sum ./
COPY clients/openchoreosvc/auth ./clients/openchoreosvc/auth
RUN go mod download

# Expose the application port
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=2m --retries=3 \
    CMD ["/tmp/agent-manager-air/agent-manager-service", "-healthcheck"]

# Run key generation script then start Air for hot-reloading
CMD ["/app/scripts/dev-entrypoint.sh"]
