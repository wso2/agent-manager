# =============================================================================
# Agent Manager Service Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_HOST=
SERVER_PORT=9000
AUTH_HEADER=Authorization
AUTO_MAX_PROCS_ENABLED=true
CORS_ALLOWED_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# File Mount Limits (Optional)
# -----------------------------------------------------------------------------
# Byte caps on the inline content of agent file mounts. All of an agent's
# mounts render into one ConfigMap/Secret, which Kubernetes limits to 1 MiB,
# so FILE_MOUNT_MAX_TOTAL_BYTES may not exceed 1048576, and the per-file cap
# may not exceed the total. Defaults: 1000000 each.
# FILE_MOUNT_MAX_FILE_BYTES=1000000
# FILE_MOUNT_MAX_TOTAL_BYTES=1000000

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=agentmanager
DB_PASSWORD=agentmanager
DB_NAME=agentmanager

# Database TLS Configuration (Optional)
# DB_SSL_MODE: disable|allow|prefer|require|verify-ca|verify-full.
# Unset leaves the driver default ("prefer"), which negotiates TLS when the
# server offers it and silently falls back to plaintext when it does not.
# DB_SSL_MODE=
# DB_SSL_ROOT_CERT: PEM CA bundle path for verify-ca/verify-full, or "system"
# to validate against the container trust store.
# DB_SSL_ROOT_CERT=

# Database Pool Configuration (Optional)
# GORM_SKIP_DEFAULT_TRANSACTION=true
# GORM_SLOW_THRESHOLD_MILLISECONDS=200
# DB_MAX_IDLE_COUNT=
# DB_MAX_OPEN_COUNT=
# DB_MAX_IDLE_TIME_SECONDS=
# DB_MAX_LIFETIME_SECONDS=

# Database Operation Timeouts (Optional)
# DB_OPERATION_TIMEOUT_SECONDS=10
# HEALTH_CHECK_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Kubernetes Configuration
# -----------------------------------------------------------------------------
KUBECONFIG=/Users/<Username>/.kube/config

# -----------------------------------------------------------------------------
# HTTP Server Timeouts (Optional)
# -----------------------------------------------------------------------------
# HTTP_READ_TIMEOUT_SECONDS=10
# HTTP_WRITE_TIMEOUT_SECONDS=90
# HTTP_IDLE_TIMEOUT_SECONDS=60
# HTTP_MAX_HEADER_BYTES=65536

# -----------------------------------------------------------------------------
# Development Environment
# -----------------------------------------------------------------------------
IS_LOCAL_DEV_ENV=true
DEFAULT_GATEWAY_PORT=19080

# -----------------------------------------------------------------------------
# JWT Signing Configuration for Agent API Tokens
# -----------------------------------------------------------------------------
JWT_SIGNING_PRIVATE_KEY_PATH=keys/private.pem
JWT_SIGNING_PUBLIC_KEYS_CONFIG=keys/public-keys-config.json
JWT_SIGNING_ACTIVE_KEY_ID=key-1
JWT_SIGNING_DEFAULT_EXPIRY=2160h
JWT_SIGNING_ISSUER=agent-manager-service
JWT_SIGNING_DEFAULT_ENVIRONMENT=default

# -----------------------------------------------------------------------------
# Key Manager Configuration (Optional)
# -----------------------------------------------------------------------------
# KEY_MANAGER_ISSUER=Agent Management Platform Local
# KEY_MANAGER_AUDIENCE=localhost
# KEY_MANAGER_JWKS_URL=

# -----------------------------------------------------------------------------
# OAuth 2.0 Protected Resource Metadata (RFC 9728)
# Required for /.well-known/oauth-protected-resource to serve.
# -----------------------------------------------------------------------------
# Externally reachable base URL of this service. Used as the `resource`
# identifier. Must use https:// in production.
# Example: https://am.example.com
SERVER_PUBLIC_URL=

# Comma-separated list of OAuth 2.0 authorization server URLs that clients
# (MCP, am CLI, etc.) should use to obtain tokens for this resource. Each
# entry must be an absolute http/https URL. Validated at startup.
# Example: https://idp.example.com
OAUTH_AUTHORIZATION_SERVERS=http://thunder.amp.localhost:8080

# When SERVER_PUBLIC_URL is set, the JWT middleware also advertises the
# /.well-known/oauth-protected-resource URL via WWW-Authenticate: Bearer
# on every 401, enabling RFC 9728 client discovery.

# -----------------------------------------------------------------------------
# Deployment Type
# -----------------------------------------------------------------------------
IS_ON_PREM_DEPLOYMENT=true
# When true, environment create, update and delete are refused with 403, for
# deployments where environments are managed outside Agent Manager.
ENABLE_ENVIRONMENT_MANAGED_MODE=false
# When true, deployment pipeline create, update and delete are refused with 403, for
# deployments where pipelines are managed outside Agent Manager.
ENABLE_DEPLOYMENT_PIPELINE_MANAGED_MODE=false

# -----------------------------------------------------------------------------
# Growth Analytics (Moesif, directly or via a collector proxy) — disabled by default
# -----------------------------------------------------------------------------
# Two streams, both off unless explicitly enabled:
#   - API feature-usage events (endpoint-level middleware → Moesif Events)
#   - Console UI actions (POST /api/v1/telemetry/console-actions → Moesif Actions)
#
# Nothing is exported unless MOESIF_ENABLED=true AND either
# MOESIF_APPLICATION_ID or MOESIF_COLLECTOR_BASE_URL is set (see Credentials
# below). Console actions additionally need CONSOLE_ANALYTICS_ENABLED=true:
#
#   MOESIF_ENABLED=false            → nothing is reported at all (master switch)
#   CONSOLE_ANALYTICS_ENABLED=false → console actions off, API events unaffected
#
# The console reads the resolved value from GET /api/v1/config, so there is no
# separate frontend flag to keep in sync.
# MOESIF_ENABLED=false
# CONSOLE_ANALYTICS_ENABLED=false
#
# Reported as each event's deployment_model / environment fields.
# AMP_DEPLOYMENT_MODEL=on-prem   (set to saas for the cloud deployment)
# AMP_ENVIRONMENT=<environment-name>
#
# Credentials — pick one:
#
#   a) Your own Moesif account: set MOESIF_APPLICATION_ID. Events are sent with
#      the X-Moesif-Application-Id header to MOESIF_COLLECTOR_BASE_URL, which
#      defaults to https://api.moesif.net when left empty. Point it at your own
#      proxy instead if you run one; it must be https unless it is localhost.
#      The Application ID is a secret: load it from a secret store.
# MOESIF_APPLICATION_ID=<your-moesif-application-id>
#
#   b) A collector proxy that holds the Application ID itself and accepts each
#      caller's own bearer JWT (how WSO2 Cloud reports). Leave
#      MOESIF_APPLICATION_ID unset and set the proxy URL.
# MOESIF_COLLECTOR_BASE_URL=http://<collector-host>:<port>/<collector-path>
#
# MOESIF_COLLECTOR_HOST_HEADER overrides the outgoing Host header — only needed
# when the proxy is reached through a port-forward or other address whose host
# does not match the gateway's virtual host.
# MOESIF_COLLECTOR_HOST_HEADER=<collector-virtual-host>

# -----------------------------------------------------------------------------
# IDP OAuth2 Configuration for Service-to-Service Auth (Optional)
# -----------------------------------------------------------------------------
# IDP_TOKEN_URL=http://thunder.amp.localhost:8080/oauth2/token
# IDP_CLIENT_ID=amp-api-client
# IDP_CLIENT_SECRET=amp-api-client-secret

# -----------------------------------------------------------------------------
# Encryption Configuration (Required)
# Hex-encoded 32-byte key for AES-256-GCM encryption of secrets at rest.
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# OpenChoreo Configuration (Required)
# -----------------------------------------------------------------------------
OPEN_CHOREO_BASE_URL=http://api.openchoreo.localhost:8195
# Workflow kind recorded on new source-built agents: "Workflow" (namespaced, runs
# on the organization's own workflow plane) or "ClusterWorkflow". Empty (the
# default) records none, which OpenChoreo treats as ClusterWorkflow.
# OPEN_CHOREO_BUILD_WORKFLOW_KIND=

# -----------------------------------------------------------------------------
# OpenTelemetry Configuration (Optional)
# -----------------------------------------------------------------------------
# OTEL_SDK_VOLUME_NAME=otel-tracing-sdk-volume
# OTEL_SDK_MOUNT_PATH=/otel-tracing-sdk
# OTEL_TRACELOOP_TRACE_CONTENT=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://opentelemetry-collector.openchoreo-observability-plane.svc.cluster.local:4318

# -----------------------------------------------------------------------------
# Observer Service Configuration (Optional)
# -----------------------------------------------------------------------------
# AM_OBSERVER_URL=http://localhost:9098
# AM_OBSERVER_PUBLIC_URL=http://localhost:9098

# -----------------------------------------------------------------------------
# GitHub Configuration (Optional)
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Agent Workload CORS Configuration (Optional)
# -----------------------------------------------------------------------------
# AGENT_WORKLOAD_CORS_ALLOWED_ORIGIN=http://localhost:3000
# AGENT_WORKLOAD_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
# AGENT_WORKLOAD_CORS_ALLOWED_HEADERS=authorization,Content-Type,Origin

# -----------------------------------------------------------------------------
# Default Chat API Configuration (Optional)
# -----------------------------------------------------------------------------
# DEFAULT_CHAT_API_HTTP_PORT=8000
# DEFAULT_CHAT_API_BASE_PATH=/

# -----------------------------------------------------------------------------
# Agent Manager Version (Optional)
# -----------------------------------------------------------------------------
# AMP_VERSION=

# -----------------------------------------------------------------------------
# API Platform Configuration (Optional)
# -----------------------------------------------------------------------------
# API_PLATFORM_BASE_URL=
# API_PLATFORM_ENABLED=false

# -----------------------------------------------------------------------------
# Secret Management Service Configuration (via OpenChoreo secret API)
# -----------------------------------------------------------------------------
# SECRET_MANAGER_PROVIDER=openchoreo
# SECRET_MANAGER_TARGET_PLANE_KIND=ClusterDataPlane
# SECRET_MANAGER_TARGET_PLANE_NAME=default

# -----------------------------------------------------------------------------
# OpenBao Configuration (AgentID Thunder provisioning only)
# -----------------------------------------------------------------------------
# OPENBAO_URL=http://localhost:8200
# OPENBAO_TOKEN=<your-openbao-token>
# OPENBAO_PATH=secret

# -----------------------------------------------------------------------------
# Workflow Plane OpenBao Configuration (for Git Secrets)
# Used to fetch git credentials for private repository access
# -----------------------------------------------------------------------------
# WORKFLOW_PLANE_OPENBAO_URL=http://localhost:8200
# WORKFLOW_PLANE_OPENBAO_TOKEN=<your-workflow-plane-openbao-token>
# WORKFLOW_PLANE_OPENBAO_PATH=secret

# -----------------------------------------------------------------------------
# Internal Server Configuration (WebSocket & Gateway Internal APIs)
# -----------------------------------------------------------------------------
INTERNAL_SERVER_HOST=
INTERNAL_SERVER_PORT=9243
INTERNAL_SERVER_CERT_DIR=./data/certs
# INTERNAL_SERVER_READ_TIMEOUT_SECONDS=10
# INTERNAL_SERVER_WRITE_TIMEOUT_SECONDS=90
# INTERNAL_SERVER_IDLE_TIMEOUT_SECONDS=60
# INTERNAL_SERVER_MAX_HEADER_BYTES=65536

# -----------------------------------------------------------------------------
# WebSocket Configuration
# -----------------------------------------------------------------------------
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_CONNECTION_TIMEOUT=30
WEBSOCKET_RATE_LIMIT_PER_MIN=10

# -----------------------------------------------------------------------------
# LLM Provider Template Configuration
# -----------------------------------------------------------------------------
LLM_TEMPLATE_DEFINITIONS_PATH=./resources/default-llm-provider-templates


# -----------------------------------------------------------------------------
# Platform-admin cross-organization routes (GET /api/v1/platform/...)
# -----------------------------------------------------------------------------
# PLATFORM_ADMIN_OU_ID is the ONLY organization allowed to call the cross-org
# routes, which read every tenant's rows. Deliberately left EMPTY here: this
# file is copied to .env verbatim, and shipping a live value would grant
# cross-organization access to whichever org it names without anyone choosing
# to. Empty denies every request to those routes, which is the safe default for
# a deployment that has not decided who its platform admin is.
#
# For the local docker-compose stack, set it to ThunderID's built-in "default"
# OU — fixed on every install, and the ouId every local token carries:
#   PLATFORM_ADMIN_OU_ID=01900000-0000-7000-8000-000000000001
PLATFORM_ADMIN_OU_ID=

# How long a gateway must have been disconnected (is_active=false) before it
# counts as failed. Lower this to make a locally-stopped gateway show up fast.
GATEWAY_FAILURE_THRESHOLD_SECONDS=300

# Far edge of the failure window: a disconnected gateway whose last update is
# older than this is treated as decommissioned, not failing. It stays in
# `total`, but is reported as `abandoned` and left OUT of the denominator the
# failure percentage is taken over. 604800 = 7 days.
# Must be greater than GATEWAY_FAILURE_THRESHOLD_SECONDS.
GATEWAY_FAILURE_MAX_AGE_SECONDS=604800

# Share of the fleet, in percent, at or above which the whole fleet is reported
# unhealthy and GET /platform/gateways/failure-summary answers 503 instead of 200.
GATEWAY_FAILURE_PERCENTAGE_THRESHOLD=10

# -----------------------------------------------------------------------------
# Gateway addressing for deployments whose gateways or evaluation jobs sit
# outside the agents' cluster (Optional, both off by default)
# -----------------------------------------------------------------------------
# Hand agents the gateway's public vhost for their LLM proxy URL when the
# gateway registered no in-cluster runtimeUrl. Off: a missing runtimeUrl fails.
# GATEWAY_PUBLIC_VHOST_FALLBACK=false
# Point scheduled evaluation jobs at the LLM proxy's public gateway vhost instead
# of the gateway's in-cluster address. Off: evaluation jobs use the in-cluster one.
# EVAL_JOBS_USE_PUBLIC_GATEWAY_URL=false
