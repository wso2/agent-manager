<mxCell id="sqldb_body" value="Agent Manager data, audit log, and secrets encrypted with ENCRYPTION_KEY (AES-256-GCM)&lt;br/&gt;&lt;i&gt;SQLite or PostgreSQL 18 today; SQL Server 2025 and Oracle 19c planned&lt;/i&gt;" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#475569;spacing=0;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="72" y="390" width="136" height="170" as="geometry" /></mxCell>
