<mxCell id="console_title" value="Console" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#0f172a;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="356" y="344" width="174" height="30" as="geometry" /></mxCell>
<mxCell id="console_body" value="Web UI for agents, gateways, LLM and MCP providers, traces and users" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#475569;spacing=0;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="318" y="380" width="204" height="120" as="geometry" /></mxCell>
<mxCell id="amapi" value="" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="560" y="330" width="560" height="180" as="geometry" /></mxCell>
<mxCell id="amapi_logo0" value="" style="fontFamily=Helvetica;shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="578" y="346" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="amapi_title" value="Agent Manager API" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#0f172a;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="616" y="344" width="494" height="30" as="geometry" /></mxCell>
<mxCell id="amapi_body" value="REST API and MCP server&lt;br/&gt;registers external agents and issues their agent tokens&lt;br/&gt;LLM, MCP, A2A and gateway config&lt;br/&gt;secrets encrypted in the SQL database&lt;br/&gt;RBAC and audit log" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#475569;spacing=0;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="578" y="380" width="524" height="120" as="geometry" /></mxCell>
<mxCell id="thunder" value="" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#e11d48;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="300" y="570" width="820" height="230" as="geometry" /></mxCell>
<mxCell id="thunder_logo0" value="" style="fontFamily=Helvetica;shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="318" y="586" width="22" height="22" as="geometry" /></mxCell>
<mxCell id="thunder_title" value="ThunderID" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#0f172a;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="352" y="584" width="758" height="30" as="geometry" /></mxCell>
<mxCell id="thunder_prod" value="one per install" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#e11d48;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="318" y="620" width="784" height="16" as="geometry" /></mxCell>
<mxCell id="thunder_body" value="&lt;b&gt;For people and services:&lt;/b&gt; single sign-on (console, CLI, MCP); users, roles and groups&lt;br/&gt;&lt;br/&gt;&lt;b&gt;For agents:&lt;/b&gt; an agent ID and OAuth client per external agent, created by Agent Manager&lt;br/&gt;&lt;br/&gt;the only identity provider; no per-environment instances" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#475569;spacing=0;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="318" y="640" width="784" height="150" as="geometry" /></mxCell>
<mxCell id="dp" value="" style="fontFamily=Helvetica;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5FF;strokeColor=#4f46e5;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="1180" y="290" width="860" height="280" as="geometry" /></mxCell>
<mxCell id="dp_lbl" value="DATA PLANE" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#4f46e5;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1200" y="298" width="820" height="20" as="geometry" /></mxCell>
<mxCell id="gw" value="" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4f46e5;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="1200" y="330" width="560" height="220" as="geometry" /></mxCell>
<mxCell id="gw_logo0" value="" style="fontFamily=Helvetica;shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="1218" y="346" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="gw_title" value="AI Gateway" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#0f172a;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1256" y="344" width="494" height="30" as="geometry" /></mxCell>
<mxCell id="gw_prod" value="bundled default gateway for the org · more can be added per org" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#4f46e5;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1218" y="380" width="524" height="16" as="geometry" /></mxCell>
<mxCell id="gw_body" value="• inbound: the public entry point for agent endpoints; API keys and OAuth tokens checked here&lt;br/&gt;• outbound: LLM and MCP proxy, guardrails, token and cost limits; provider keys stay in the gateway&lt;br/&gt;• rate-limit counters kept in memory" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#475569;spacing=0;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="1218" y="400" width="524" height="140" as="geometry" /></mxCell>
<mxCell id="tracegw" value="" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d97706;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="1780" y="330" width="240" height="220" as="geometry" /></mxCell>
<mxCell id="tracegw_logo0" value="" style="fontFamily=Helvetica;shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="1798" y="346" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="tracegw_title" value="Trace ingest" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#0f172a;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1836" y="344" width="174" height="30" as="geometry" /></mxCell>
<mxCell id="tracegw_prod" value="/otel route on the AI Gateway" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#d97706;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1798" y="380" width="204" height="16" as="geometry" /></mxCell>
<mxCell id="tracegw_body" value="OTLP at /otel/v1/traces&lt;br/&gt;checks the agent token&lt;br/&gt;maps its organization, project and agent claims to x-user-*-name headers&lt;br/&gt;forwards to the OTel Collector" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#475569;spacing=0;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="1798" y="400" width="204" height="140" as="geometry" /></mxCell>
<mxCell id="op" value="" style="fontFamily=Helvetica;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#d97706;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="1180" y="610" width="860" height="210" as="geometry" /></mxCell>
<mxCell id="op_lbl" value="OBSERVABILITY PLANE" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#d97706;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1200" y="618" width="820" height="20" as="geometry" /></mxCell>
<mxCell id="observer" value="" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d97706;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="1200" y="646" width="260" height="140" as="geometry" /></mxCell>
<mxCell id="observer_logo0" value="" style="fontFamily=Helvetica;shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="1218" y="662" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="observer_title" value="Agent Manager Observer" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#0f172a;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1256" y="660" width="194" height="30" as="geometry" /></mxCell>
<mxCell id="observer_body" value="traces per agent for the console, CLI and AI assistants&lt;br/&gt;queries OpenSearch directly" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#475569;spacing=0;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="1218" y="696" width="224" height="80" as="geometry" /></mxCell>
<mxCell id="tags" value="&lt;b&gt;Tenant tags on every span&lt;/b&gt;&lt;br/&gt;agent token claims: organization · project · agent&lt;br/&gt;↓ gateway headers: x-user-*-name&lt;br/&gt;↓ resource attributes: agent-manager/*&lt;br/&gt;the observer filters queries on these" style="fontFamily=Helvetica;rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF1DC;strokeColor=#d97706;strokeWidth=1;fontSize=11.5;fontColor=#0f172a;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=10;" parent="1" vertex="1"><mxGeometry x="1480" y="646" width="260" height="140" as="geometry" /></mxCell>
<mxCell id="collect" value="" style="fontFamily=Helvetica;rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d97706;strokeWidth=1.5;" parent="1" vertex="1"><mxGeometry x="1760" y="646" width="260" height="140" as="geometry" /></mxCell>
<mxCell id="collect_logo0" value="" style="fontFamily=Helvetica;shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="1778" y="662" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="collect_title" value="Collect" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#0f172a;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1816" y="660" width="194" height="30" as="geometry" /></mxCell>
<mxCell id="collect_prod" value="OpenTelemetry Collector" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#d97706;spacing=0;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1778" y="696" width="224" height="16" as="geometry" /></mxCell>
<mxCell id="collect_body" value="adds agent-manager/* resource attributes from the headers; writes spans to OpenSearch" style="fontFamily=Helvetica;text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#475569;spacing=0;fontStyle=0;" parent="1" vertex="1"><mxGeometry x="1778" y="716" width="224" height="60" as="geometry" /></mxCell>
