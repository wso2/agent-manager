# --- Required --------------------------------------------------------------
# Both skills call OpenAI: one to summarize, one to extract action items.
OPENAI_API_KEY=

# --- Optional --------------------------------------------------------------
# Model used by both skills.
OPENAI_MODEL=gpt-4o-mini

# The address this agent advertises for itself in its agent card. Change it when
# clients reach the agent somewhere other than localhost.
AGENT_PUBLIC_BASE_URL=http://localhost:9099
