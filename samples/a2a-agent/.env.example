# --- Required --------------------------------------------------------------
# Both skills call OpenAI: one to summarize, one to extract action items.
OPENAI_API_KEY=

# --- Optional --------------------------------------------------------------
# Model used by both skills.
OPENAI_MODEL=gpt-5.6-luna

# The address this agent advertises for itself in its agent card. AMP's gateway
# rewrites the card it serves to its own address, so the default is only what a
# client running against the agent directly needs.
AGENT_PUBLIC_BASE_URL=http://localhost:9099

# Where the agent exports its traces. A deployed agent gets both from AMP; for a
# local run, take them from the agent's page in the AMP Console. Leave them
# unset to run untraced.
AMP_OTEL_ENDPOINT=
AMP_AGENT_API_KEY=

# Whether spans carry message content: the notes callers send, the system
# prompts and the model's replies. This matches AMP's own default, so the
# Console shows each request and result. Content then sits in AMP's trace store
# for anyone who can read the agent's traces, so set it to false when the
# messages may hold sensitive data. The spans, IDs, states and token usage
# stay either way.
AMP_TRACE_CONTENT=true
