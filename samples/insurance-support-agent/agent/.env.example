OPENAI_API_KEY=

# The web client defaults to 8000.
PORT=8000

# Lets a browser call this agent directly. Leave it unset when a proxy in front
# of the agent already sends CORS headers.
CORS_ALLOW_ORIGINS=http://localhost:5173

